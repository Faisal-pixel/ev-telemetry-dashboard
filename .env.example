# ---------------------------------------------------------------------------
# Firebase Realtime Database URL - paste yours here (no trailing slash).
# Outside the US it looks like https://NAME-default-rtdb.europe-west1.firebasedatabase.app
# The SAME URL goes into FIREBASE_HOST in both .ino files.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_DB_URL=https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com

# ---------------------------------------------------------------------------
# Alert limits. This is the ONLY place the dashboard keeps them.
# LOW_VOLTAGE_V must match LOW_VOLTAGE_ALERT in EV_Telemetry_Firebase.ino.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LOW_VOLTAGE_V=65
NEXT_PUBLIC_LOW_SOC_PCT=20
NEXT_PUBLIC_HIGH_TEMP_C=45
NEXT_PUBLIC_HIGH_VIBRATION_PCT=70

# A device is shown as "stale" when its newest reading is older than this.
NEXT_PUBLIC_STALE_AFTER_S=30
